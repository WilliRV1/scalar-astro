# Copia este archivo a .env y rellena los valores.
#
# La llave anónima viaja al navegador POR DISEÑO: identifica, no autoriza.
# Eso solo es seguro porque todas las tablas tienen RLS. Nunca pongas aquí la
# llave `service_role`: esa salta la RLS y solo vive en Edge Functions.
#
# Desarrollo local (no necesita cuenta en la nube):
#   npx supabase start    -> imprime la URL y la anon key locales

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Celular de contacto que muestra la portada pública, solo dígitos con
# indicativo (573001234567). Si falta, la portada oculta el botón de WhatsApp
# en vez de inventarse un número.
VITE_CONTACTO_WHATSAPP=
